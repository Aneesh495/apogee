{erl_opts, [
    debug_info,
    warn_export_vars,
    warn_shadow_vars,
    warn_obsolete_guard,
    warn_unused_import
]}.

{deps, []}.

{shell, [
    {apps, [apogee]}
]}.

{escript_name, "apogee"}.
{escript_emu_args, "%%! -escript main apogee_escript +sbtu +A 4\n"}.
{escript_incl_apps, [apogee]}.

{profiles, [
    {test, [
        {erl_opts, [debug_info, nowarn_export_all]}
    ]}
]}.
